# Vox runs in full zero-config demo mode with none of these set. Add a
# variable below to upgrade that piece from a demo/in-memory fallback to a
# real, live service. See README.md for what each upgrade unlocks.

# ---- Core -------------------------------------------------------------------
# Postgres (e.g. Neon via the Vercel Marketplace). Without it, everything runs
# on in-memory demo data.
DATABASE_URL=

# Signs session cookies. Set a long random value in production.
# Required in production. Generate with: openssl rand -base64 32
SESSION_SECRET=

# ---- AI model (chat + voice brain, RAG embeddings) ---------------------------
# Vercel AI Gateway key. Without it, agents use a built-in keyword responder.
AI_GATEWAY_API_KEY=
VOX_MODEL=anthropic/claude-haiku-4-5
VOX_EMBED_MODEL=openai/text-embedding-3-small
# Alternative to AI_GATEWAY_API_KEY: call OpenAI directly from Python.
OPENAI_API_KEY=
VOX_OPENAI_MODEL=gpt-4.1-mini
VOX_OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Voice telephony (Twilio) -------------------------------------------------
# Presence of TWILIO_ACCOUNT_SID flips the "Voice telephony" status to
# connected. TWILIO_AUTH_TOKEN enables webhook signature verification and is
# mandatory in production; production webhooks fail closed without it.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The voice number you point at /api/voice/incoming — used by the seed route
# to route that number to the demo workspace.
TWILIO_PHONE_NUMBER=
VOX_TTS_VOICE=Polly.Joanna-Neural
# ElevenLabs provides browser and live-call TTS, plus live-call transcription.
# Per-agent
# voice ("Micheal — calm, professional", "Leo — calm, low", ...) resolves to a real
# ElevenLabs voice ID automatically (see src/lib/voice/elevenlabs-voices.ts).
# Set ELEVENLABS_VOICE_ID only to force one voice for every agent.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_CALL_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v2
# Voice used specifically by Micheal on /demo.
ELEVENLABS_DEMO_VOICE_ID=
# Optional fallback and legacy-label mappings.
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_AVA_VOICE_ID=
ELEVENLABS_MICHEAL_VOICE_ID=
ELEVENLABS_MAYA_VOICE_ID=
ELEVENLABS_LEO_VOICE_ID=
ELEVENLABS_SAM_VOICE_ID=

# ---- WhatsApp (Twilio) ---------------------------------------------------------
# The WhatsApp sender you point at /api/whatsapp/incoming.
TWILIO_WHATSAPP_NUMBER=

# ---- Appointments (Google Calendar) -------------------------------------------
# OAuth client from a Google Cloud project with the Calendar API enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Encrypts stored Google refresh tokens at rest (any random string; required
# for the Google Calendar integration to be considered configured).
TOKEN_ENCRYPTION_KEY=
VOX_DEFAULT_TIMEZONE=Africa/Harare

# ---- Invoices (PDF + email) ----------------------------------------------------
# Resend API key. Without it, invoices are created and downloadable as PDF but
# not emailed automatically.
RESEND_API_KEY=
INVOICE_FROM_EMAIL=invoices@yourdomain.com

# ---- Billing (Vox's own subscription billing, unrelated to client invoices) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
# Stripe CLI/dashboard webhook endpoint: /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# ---- Deployment ----------------------------------------------------------------
# Public base URL of this deployment. Used to validate Twilio webhook
# signatures and to build the Google OAuth redirect URI.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Python bot engine -------------------------------------------------------
# The Next.js UI and integrations send every bot turn to this separate service.
VOX_BOT_SERVICE_URL=http://127.0.0.1:8000
# Set the same random secret in the Next.js app and Python service.
VOX_BOT_SERVICE_TOKEN=
VOX_MEDIA_STREAM_URL=wss://your-railway-domain.up.railway.app/v1/twilio-media
VOX_APP_URL=https://your-vercel-domain.vercel.app
# Comma-separated Vox staff accounts allowed to review/build/publish requests.
VOX_ADMIN_EMAILS=demo@vox.ai
# Optional OpenAI-compatible endpoint used by the Python engine.
VOX_AI_BASE_URL=https://ai-gateway.vercel.sh/v1
VOX_STT_MODEL=gpt-4o-mini-transcribe
VOX_TTS_MODEL=openai/gpt-4o-mini-tts
VOX_TTS_VOICE_NAME=shimmer
# OpenAI fallback voice used by Railway if ElevenLabs is temporarily unavailable.
VOX_OPENAI_TTS_MODEL=gpt-4o-mini-tts
VOX_OPENAI_TTS_VOICE=cedar
