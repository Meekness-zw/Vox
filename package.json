{
  "name": "aivoice-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "node scripts/dev-all.mjs",
    "bot:setup": "/usr/bin/python3 -m venv bot-service/.venv && bot-service/.venv/bin/pip install -r bot-service/requirements.txt",
    "bot:dev": "bot-service/.venv/bin/uvicorn app.main:app --app-dir bot-service --host 127.0.0.1 --port 8000 --env-file .env --reload",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types scripts/test-core.mjs && PYTHONPATH=bot-service bot-service/.venv/bin/python -m unittest discover -s bot-service/tests -v"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.196",
    "ai": "^6.0.194",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "googleapis": "^173.0.0",
    "lucide-react": "^1.17.0",
    "next": "^16.2.12",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "resend": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
